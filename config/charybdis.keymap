#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <170>;
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    tapping-term-ms = <170>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    // z

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    hml: home_row_mod_left {
        compatible = "zmk,behavior-hold-tap";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54>;
        hold-trigger-on-release;
    };

    hmr: home_row_mod_right {
        compatible = "zmk,behavior-hold-tap";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 55>;
    };

    // Layer definitions

    #define BASE 0
    #define LOWER 1
    #define RAISE 2
    #define MOUSE 3
    #define CONFIG 4
    #define SCROLL 5
    #define SNIPING 6

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        SETS {
            bindings = <&none>;
            key-positions = <54 55>;
            timeout-ms = <50>;
            layers = <4>;
        };
    };

    macros {
        win_capture: win_capture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LWIN &kp LALT &kp S>;
            label = "WIN_CAPTURE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp GRAVE       &kp N1              &kp N2          &kp N3          &kp N4            &kp N5           &kp N6           &kp N7       &kp N8      &kp N9           &kp N0                  &kp MINUS
&kp TAB         &kp Q               &kp W           &kp E           &kp R             &kp T            &kp Y            &kp U        &kp I       &kp O            &kp P                   &kp EQUAL
&kp ESCAPE      &mt LEFT_CONTROL A  &mt LEFT_ALT S  &mt LEFT_WIN D  &mt LSHIFT F      &kp G            &kp H            &mt RSHFT J  &mt RWIN K  &mt RIGHT_ALT L  &mt RIGHT_CONTROL SEMI  &kp SQT
&kp LEFT_SHIFT  &lt 3 Z             &kp X           &kp C           &kp V             &kp B            &kp N            &kp M        &kp COMMA   &kp PERIOD       &lt 3 SLASH             &kp RIGHT_SHIFT
                                                    &kp LWIN        &kp LEFT_CONTROL  &lt 1 TAB        &lt 2 BACKSPACE  &kp SPACE
                                                                    &kp DEL           &kp BACKSPACE    &kp RET
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        LOWER {
            bindings = <
&kp F12          &kp F1  &kp F2    &kp F3          &kp F4     &kp F5              &kp F6             &kp F7      &kp F8  &kp F9  &kp F10       &kp F11
&trans           &trans  &trans    &kp UP_ARROW    &trans     &kp LBRC            &kp RBRC           &kp N7      &kp N8  &kp N9  &kp PLUS      &kp MINUS
&kp PRINTSCREEN  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N4      &kp N5  &kp N6  &kp ASTERISK  &kp SLASH
&kp LSHFT        &trans  &trans    &trans          &trans     &kp LPAR            &kp RPAR           &kp N1      &kp N2  &kp N3  &kp EQUAL     &kp RSHIFT
                                   &trans          &trans     &trans              &kp N0             &kp PERIOD
                                                   &kp INS    &trans              &kp RETURN
            >;
        };

        RAISE {
            bindings = <
&kp F12       &kp F1    &kp F2  &kp F3    &kp F4     &kp F5                               &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans        &kp EXCL  &kp AT  &kp HASH  &trans     &trans                               &trans  &trans  &trans  &trans  &trans   &trans
&trans        &trans    &trans  &trans    &trans     &trans                               &trans  &trans  &trans  &trans  &trans   &trans
&kp CAPSLOCK  &trans    &trans  &trans    &trans     &trans                               &trans  &trans  &trans  &trans  &trans   &kp CAPS
                                &kp HOME  &kp PG_UP  &kp END                              &trans  &trans
                                          &kp PG_DN  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS    &trans
            >;
        };

        MOUSE {
            bindings = <
&trans      &trans            &trans        &trans    &trans      &trans      &trans    &trans      &trans    &trans         &trans             &trans
&trans      &trans            &trans        &trans    &trans      &trans      &trans    &trans      &trans    &trans         &trans             &trans
&trans      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LGUI  &kp LSHIFT  &trans      &trans    &kp RSHIFT  &kp RWIN  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&kp LSHIFT  &trans            &mo 5         &mo 6     &none       &none       &mkp MB1  &mkp MB3    &mkp MB2  &trans         &trans             &kp RSHIFT
                                            &mkp MB1  &mkp MB4    &mkp MB5    &mkp MB3  &mkp MB2
                                                      &mkp MB3    &mkp MB2    &mkp MB1
            >;
        };

        CONFIG {
            bindings = <
&trans          &trans  &trans  &trans  &trans         &trans          &trans        &trans      &trans      &trans      &trans  &trans
&trans          &trans  &trans  &trans  &trans         &trans          &bt BT_SEL 0  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &trans  &trans
&studio_unlock  &trans  &trans  &trans  &trans         &trans          &bt BT_SEL 1  &trans      &trans      &trans      &trans  &trans
&trans          &trans  &trans  &trans  &trans         &trans          &bt BT_SEL 2  &trans      &trans      &trans      &trans  &trans
                                &trans  &trans         &trans          &trans        &trans
                                        &kp C_BRI_DEC  &kp C_BRI_UP    &kp K_LOCK
            >;
        };

        scroll_layer {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        sniping_layer {
            label = "SNIPING";
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
